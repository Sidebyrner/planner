# Copy to .env for local use. On a host, set these as secrets instead.

# Where the app is reached from a browser. Must match the Google redirect URI.
PUBLIC_URL=http://localhost:8787
PORT=8787
DATABASE_PATH=./data/planner.db

# Required when NODE_ENV=production. Leave unset locally to skip the login.
APP_PASSWORD=
# Bearer token agents send to /mcp. Generate with: openssl rand -base64 32
MCP_TOKEN=
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Google Calendar (optional). See "Connect Google Calendar" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
