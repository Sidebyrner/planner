# Copy to .env for local use. On a host, set these as secrets instead.

# Where the app is reached from a browser. Must match the Google redirect URI.
PUBLIC_URL=http://localhost:8787
PORT=8787
# Interface to listen on. Leave unset for all; use 127.0.0.1 behind tailscale serve or another local proxy.
HOST=
DATABASE_PATH=./data/planner.db

# Required when NODE_ENV=production. Leave unset locally to skip the login.
APP_PASSWORD=
# Bearer token agents send to /mcp. Generate with: openssl rand -base64 32
MCP_TOKEN=
# Bearer token the iOS and macOS apps send to /api. Generate with: openssl rand -base64 32
DEVICE_TOKEN=
# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Google Calendar (optional). See "Connect Google Calendar" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Block-start webhook (optional). Planner POSTs {"type":"block.started", block, tasks, nextStep, links}
# here as each task block begins, so a nudge can go out on time. WEBHOOK_SECRET signs each body:
# header X-Planner-Signature: sha256=<HMAC-SHA256 of the body, hex>.
WEBHOOK_URL=
WEBHOOK_SECRET=
